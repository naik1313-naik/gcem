# Public Supabase project configuration. These values are safe for the browser.
# Get them from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional local-only demo mode. When true, the app uses built-in demo accounts
# and in-memory alarm/incident data instead of Supabase. Never enable this for a
# production deployment.
DEMO_MODE=false
DEMO_SESSION_SECRET=replace-with-a-long-random-string

# Demo login passwords are fixed in lib/demo-accounts.ts:
# admin@windsage.demo / Admin@123
# mechanical@windsage.demo / Mechanical@123
# electrical@windsage.demo / Electrical@123
# reliability@windsage.demo / Reliability@123

# Optional: only used by the local verification script in tests/integration.
# Use a separate development Supabase project, never production.
TEST_SUPABASE_URL=https://your-dev-project-ref.supabase.co
TEST_SUPABASE_ANON_KEY=your-dev-anon-key
TEST_USER_EMAIL=test-operator@example.com
TEST_USER_PASSWORD=replace-with-a-test-password

# Optional: only used by scripts/seed.ts to populate the dev project.
SEED_USER_EMAIL=operator@example.com
SEED_USER_PASSWORD=replace-with-a-password

# Do not add a service-role key here. The application never uses one.
